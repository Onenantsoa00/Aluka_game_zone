PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gamecenter_db

# Fuseau metier des salles (journee de caisse, cloture, recettes)
APP_TIMEZONE=Indian/Antananarivo
# Heure de fermeture : les sessions encore actives sont cloturees et marquees « a verifier »
CLOSING_HOUR=23
# Frequence du job de maintenance (minutes)
MAINTENANCE_INTERVAL_MINUTES=5
# Origine autorisee pour CORS / socket.io (separees par des virgules, * = tout)
CORS_ORIGIN=*
